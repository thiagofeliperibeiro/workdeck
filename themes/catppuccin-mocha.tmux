set -g @wd_accent "#cba6f7"
set -g @wd_on_accent "#11111b"
set -g @wd_surface "#313244"
set -g @wd_text "#cdd6f4"
set -g @wd_dim "#6c7086"
set -g @wd_muted "#7f849c"
set -g status-style "bg=#181825,fg=#7f849c"
setw -g pane-border-style "fg=#313244,bg=#1e1e2e"
setw -g pane-active-border-style "fg=#6c7086,bg=#1e1e2e"
set -g message-style "bg=#313244,fg=#cdd6f4,bold"
set -g mode-style "bg=#45475a,fg=#cdd6f4"
setw -g window-style "bg=#1e1e2e,fg=#cdd6f4"
setw -g window-active-style "bg=#1e1e2e,fg=#cdd6f4"
