#!/usr/bin/env bash
. "${WORKDECK_LIB_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/workdeck/lib}/common.sh" 2>/dev/null || msg() { printf '%s' "$1"; }
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/workdeck/projects.conf"
purple=$'\033[38;5;183m'; green=$'\033[38;5;151m'; yellow=$'\033[38;5;223m'; dim=$'\033[2m'; x=$'\033[0m'

[ -f "$CONFIG" ] || { echo "${dim}$(msg panel_projects_none)${x}"; exit 0; }

print_without_git() {
  printf '%-14s %s%-20s%s %s%s%s\n' "$1" "$dim" "-" "$x" "$dim" "$2" "$x"
}

found=0
missing=0
while IFS= read -r line; do
  line="${line%%#*}"; [ -z "${line// }" ] && continue
  IFS="|" read -r name dir cmd <<< "$line"
  [ -n "$cmd" ] && continue
  found=1
  dir="${dir/#\~/$HOME}"; dir="${dir//\$\{HOME\}/$HOME}"; dir="${dir//\$HOME/$HOME}"

  if [ ! -d "$dir" ]; then
    print_without_git "$name" "$(msg panel_dir_missing)"
    missing=1
    continue
  fi

  if [ ! -e "$dir/.git" ]; then
    print_without_git "$name" "$(msg panel_no_git)"
    continue
  fi

  branch=$(git -C "$dir" branch --show-current 2>/dev/null)
  changed=$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  if [ "$changed" -gt 0 ]; then
    status="${yellow}$(msg panel_changed "$changed")${x}"
  else
    status="${green}$(msg panel_clean)${x}"
  fi
  printf '%-14s %s%-20s%s %s\n' "$name" "$purple" "${branch:-?}" "$x" "$status"
done < "$CONFIG"
[ "$found" = 1 ] || echo "${dim}$(msg panel_projects_none)${x}"

if [ "$missing" = 1 ]; then
  echo "${dim}$(msg panel_dir_missing_hint)${x}"
fi
