#!/usr/bin/env bash
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/workdeck"

projects=0
if [ -f "$CONFIG_DIR/projects.conf" ]; then
  projects=$(grep -v '^[[:space:]]*#' "$CONFIG_DIR/projects.conf" | awk -F'|' 'NF >= 2 && $3 == ""' | wc -l | tr -d ' ')
fi
code="${XDG_DATA_HOME:-$HOME/.local/share}/workdeck"
command -v work >/dev/null && work update --check >/dev/null 2>&1
version="$(git -C "$code" describe --tags --abbrev=0 2>/dev/null || true)"
latest="$(sed -n 's/^latest=//p' "${XDG_CACHE_HOME:-$HOME/.cache}/workdeck/update" 2>/dev/null | tail -1)"

m=$'\033[48;5;183m'; e=$'\033[48;5;234m'; x=$'\033[0m'
purple=$'\033[1;38;5;183m'; dim=$'\033[2m'; yellow=$'\033[33m'; green=$'\033[32m'

logo=(
  ".MMMMMMMMM."
  "MMMMMMMMMMM"
  "MMEMMMMMMMM"
  "MMMEMMMMMMM"
  "MMMMEMMMMMM"
  "MMMEMMMMMMM"
  "MMEMMEEEEMM"
  "MMMMMMMMMMM"
  ".MMMMMMMMM."
)

if [ "$projects" -gt 0 ]; then
  projects_line="${green}✓${x} projetos  $projects"
else
  projects_line="${yellow}!${x} projetos  nenhum ainda"
fi
version_line=""
highest="$(printf '%s\n%s\n' "$latest" "${version:-v0.0.0}" | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | awk -F'[v.]' '{printf "%09d%09d%09d %s\n", $2, $3, $4, $0}' | sort | tail -1 | cut -d' ' -f2)"
if [ -n "$latest" ] && [ "$latest" != "$version" ] && [ "$highest" = "$latest" ]; then
  version_line="${yellow}●${x} ${version:-sem versão} → $latest: work update"
elif [ -n "$version" ]; then
  version_line="${dim}$version${x}"
fi

text=(
  ""
  ""
  "${purple}workdeck${x}  $version_line"
  "${dim}terminal para agentes de IA${x}"
  ""
  "$projects_line"
  ""
  ""
  ""
)

for ((i = 0; i < ${#logo[@]}; i++)); do
  line=""
  row="${logo[$i]}"
  for ((j = 0; j < ${#row}; j++)); do
    case "${row:$j:1}" in
      M) line="$line$m  " ;;
      E) line="$line$e  " ;;
      *) line="$line$x  " ;;
    esac
  done
  printf '%s%s   %s\n' "$line" "$x" "${text[$i]}"
done
echo

step() {
  local n
  n=$(printf '%s' "$1" | LC_ALL=C tr -d '\200-\277' | wc -c)
  printf '  %s%s%*s%s %s\n' "$purple" "$1" $((22 - n)) "" "$x" "$2"
}

if [ "$projects" = 0 ]; then
  printf '%sPara começar%s, no terminal aqui embaixo:\n' "$purple" "$x"
  step "work add ~/projeto" "cada projeto vira uma janela; Tab completa o caminho"
  echo
fi

if [ -n "${TMUX:-}" ] && [ "$(tmux display -p '#{client_termname}' 2>/dev/null)" != xterm-kitty ]; then
  if [ -n "${WARP_CLIENT_VERSION:-}" ]; then
    printf '%sNo Warp%s: o work funciona com os atalhos Alt; os atalhos cmd só valem no kitty.\n\n' "$purple" "$x"
  else
    printf '%sFora do kitty%s: o work funciona, mas o tema, a fonte e os atalhos cmd só valem lá.\n\n' "$purple" "$x"
  fi
fi

printf '%sCtrl+b h abre o menu: projetos, review, dividir a tela%s\n' "$dim" "$x"

custom=0
for f in "$CONFIG_DIR"/panels/*; do
  case "$(basename "$f")" in 00-workdeck|20-projetos) continue ;; esac
  [ -x "$f" ] && custom=$((custom + 1))
done
if [ "$custom" = 0 ]; then
  printf '%sPara pôr o seu no painel: um executável em ~/.config/workdeck/panels/%s\n' "$dim" "$x"
  printf '%s  guia: github.com/workdeckdev/workdeck/blob/main/docs/panels.pt-BR.md%s\n' "$dim" "$x"
fi
